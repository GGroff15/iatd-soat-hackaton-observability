{
  "uid": "soat-observability",
  "title": "SOAT Observability",
  "tags": ["soat", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (probe_success{job=~\"blackbox-http|blackbox-tcp\"})",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Probe Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=~\"blackbox-http|blackbox-tcp\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Collector Telemetry Received",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans[5m]))",
          "legendFormat": "spans/sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_receiver_accepted_log_records[5m]))",
          "legendFormat": "logs/sec"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points[5m]))",
          "legendFormat": "metric points/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RabbitMQ Queue Messages",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages{job=\"rabbitmq-per-object\"}",
          "legendFormat": "{{queue}} total"
        },
        {
          "refId": "B",
          "expr": "rabbitmq_queue_messages_ready{job=\"rabbitmq-per-object\"}",
          "legendFormat": "{{queue}} ready"
        },
        {
          "refId": "C",
          "expr": "rabbitmq_queue_messages_unacked{job=\"rabbitmq-per-object\"}",
          "legendFormat": "{{queue}} unacked"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "RabbitMQ Message Rates",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rabbitmq_global_messages_received_total{job=\"rabbitmq\"}[5m]))",
          "legendFormat": "published/sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(rabbitmq_global_messages_routed_total{job=\"rabbitmq\"}[5m]))",
          "legendFormat": "routed/sec"
        },
        {
          "refId": "C",
          "expr": "sum(rate(rabbitmq_global_messages_delivered_total{job=\"rabbitmq\"}[5m]))",
          "legendFormat": "delivered/sec"
        },
        {
          "refId": "D",
          "expr": "sum(rate(rabbitmq_global_messages_acknowledged_total{job=\"rabbitmq\"}[5m]))",
          "legendFormat": "acked/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "msgps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "RabbitMQ DLQ Messages",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages{job=\"rabbitmq-per-object\",queue=~\"uploads_dlq_queue|analysis_response_dlq_queue\"}",
          "legendFormat": "{{queue}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 5
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "SOAT Logs (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"soat\", service_name=~\".+\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 16,
        "h": 8
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "SOAT Traces (Tempo)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.namespace = \"soat\" && resource.service.name != \"\" }"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      }
    }
  ]
}
